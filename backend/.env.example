# WardPay API configuration. Copy to .env for local development.
# Every setting the backend reads is listed here. Never commit a real .env.

# --- Core -------------------------------------------------------------------
# development | test | production. Production refuses unsafe combinations at startup.
ENVIRONMENT=development
# Never true in production (startup fails if it is)
DEBUG=false
# Product name shown to parents and staff (texts, emails, receipts, authenticator app)
APP_NAME=WardPay
# Signs JWTs and derives the blind-index key. 32+ random characters:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string-of-at-least-32-chars
LOG_LEVEL=INFO

# --- Database and queue -----------------------------------------------------
# PostgreSQL via psycopg 3 (postgres:// and postgresql:// are accepted too)
DATABASE_URL=postgresql+psycopg://wardpay:wardpay@localhost:5432/wardpay
# Just the address: redis:// or rediss:// (TLS). Startup refuses anything else.
REDIS_URL=redis://localhost:6379/0
# true runs background tasks in-process (local development without Redis). Never in production.
CELERY_TASK_ALWAYS_EAGER=false
# Rate-limit counters. memory:// for development; use the Redis URL in production.
RATE_LIMIT_STORAGE_URL=memory://
RATE_LIMITS_ENABLED=true

# --- Encryption -------------------------------------------------------------
# Comma-separated Fernet keys. The first encrypts; all decrypt (prepend a new key to rotate).
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing every key makes encrypted data (MFA secrets, guardian contact details) unreadable: back it up.
FIELD_ENCRYPTION_KEYS=

# --- Web --------------------------------------------------------------------
# Comma-separated browser origins allowed to call the API (no wildcard in production)
CORS_ORIGINS=http://localhost:5175
# Where the web app lives (used in emailed links)
FRONTEND_URL=http://localhost:5175
# Reverse proxies in front of the API whose X-Forwarded-For header is trusted (0 = none)
NUM_PROXIES=0

# --- Authentication ---------------------------------------------------------
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
MFA_ISSUER=WardPay
# Proprietors and bursars must enrol in two-factor sign-in before using the console
ENFORCE_MFA=true
# Sign-in rate limits ("N/period", e.g. 20/minute, 10/hour)
LOGIN_RATE_PER_IP=20/minute
LOGIN_RATE_PER_ACCOUNT=10/hour
PASSWORD_RESET_RATE=5/hour
# How long invite and password-reset links stay valid (hours)
PASSWORD_LINK_HOURS=48

# --- Database pool and limits ------------------------------------------------
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10
# Largest request body accepted, in bytes (spreadsheet imports are the largest)
MAX_REQUEST_BODY_BYTES=10485760
# Migrations only (python -m app.core.migrate): a role that owns the schema.
# Falls back to DATABASE_URL in development. The API itself never needs it.
MIGRATION_DATABASE_URL=

# --- Email ------------------------------------------------------------------
# console (log subject only) | smtp. ("memory" is for tests and refused in production.)
EMAIL_BACKEND=console
EMAIL_FROM=WardPay <no-reply@wardpay.ng>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# --- Payments ---------------------------------------------------------------
# Comma-separated gateways schools may use: paystack, flutterwave (fake = simulated; never in production)
PAYMENT_GATEWAYS=paystack
PAYSTACK_SECRET_KEY=
# Bank Paystack issues students' dedicated virtual accounts from (wema-bank, titan-paystack, ...)
PAYSTACK_PREFERRED_BANK=wema-bank
FLUTTERWAVE_SECRET_KEY=
# The "secret hash" configured in the Flutterwave dashboard (sent back on every webhook)
FLUTTERWAVE_WEBHOOK_HASH=
# Path on FRONTEND_URL the gateway sends parents back to after a card payment
PAYMENT_CALLBACK_PATH=/pay/complete
# Days a parent's family payment link works before a fresh one goes out with the next message
FAMILY_LINK_DAYS=120
# Bachs (https://docs.bachs.io): sk_sandbox_... (sandbox) or sk_live_..., and the webhook endpoint's signing secret
BACHS_SECRET_KEY=
BACHS_WEBHOOK_SECRET=

# --- Platform billing and school sign-up ---------------------------------------
# The platform's own bank account, printed on subscription invoices (schools pay by transfer)
PLATFORM_BANK_NAME=
PLATFORM_ACCOUNT_NUMBER=
PLATFORM_ACCOUNT_NAME=
# Days a school has to pay a subscription invoice
SUBSCRIPTION_DUE_DAYS=30
# Contact shown on the public website and privacy notice
SUPPORT_EMAIL=
# Schools can sign themselves up at /signup (true/false), limited per IP address
SIGNUP_ENABLED=true
SIGNUP_RATE_PER_IP=5/hour
# Signed-up schools whose proprietor never confirms are deleted after this many days
PENDING_SCHOOL_DAYS=14

# --- Data protection (NDPA) retention -------------------------------------------
# Pupils who left this many years ago (and parents with no other children on record) are anonymised
RECORDS_RETENTION_YEARS=6
# Message texts to parents are cleared after this many days (who/when/how is kept)
MESSAGE_BODY_RETENTION_DAYS=365

# --- Error monitoring (Sentry), off unless set; events are scrubbed of personal data ---
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
# Shown in error reports, e.g. the git commit being deployed
RELEASE=

# --- Text messages and parent sign-in ----------------------------------------
# console (log only, never the text) | termii | africastalking. ("memory" is for tests and refused in production.)
# With keys for both providers, a platform admin switches between them in the console (Platform → Providers);
# SMS_BACKEND is the default until then.
SMS_BACKEND=console
TERMII_API_KEY=
# Sender ID registered with Termii (up to 11 characters)
TERMII_SENDER_ID=WardPay
# Texts through Africa's Talking use AFRICASTALKING_USERNAME / AFRICASTALKING_API_KEY (below), plus its
# registered sender ID or short code (empty: Africa's Talking's own). Username "sandbox" uses their sandbox.
AFRICASTALKING_SMS_SENDER=
# Parent sign-in codes: lifetime, attempts allowed, and request limits
OTP_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RATE_PER_PHONE=3/10minutes
OTP_RATE_PER_IP=20/hour

# --- WhatsApp and messages to parents -----------------------------------------
# off (SMS then email) | console (log only) | cloud (Meta WhatsApp Cloud API). "memory" is for tests.
WHATSAPP_BACKEND=off
# Permanent system-user token and the sending phone number's ID (WhatsApp Manager)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_LANGUAGE=en
# Approved template names per message kind; parameter order is in docs/DEPLOYMENT.md
WHATSAPP_TEMPLATES=receipt=payment_receipt,fee_notice=fee_notice,reminder=fee_reminder
# Phone calls to parents who prefer them: console (log only) | africastalking. "memory" is for tests.
VOICE_BACKEND=console
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
# The voice number calls come from, e.g. +2347000000000
AFRICASTALKING_VOICE_NUMBER=
# Calls only between these hours, Lagos time
CALL_HOURS_START=9
CALL_HOURS_END=19
# Messages still queued after this many hours are skipped instead of sent late
MESSAGE_MAX_AGE_HOURS=24
# No bill notices or reminders between these hours, Lagos time (receipts still go)
QUIET_HOURS_START=20
QUIET_HOURS_END=7
